# ------------------------------
# Bash:  docker compose -f docker-compose.yml build openmu
# ------------------------------

# ---- Build stage (compila tudo) -------------------------------------------------
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# --- 1️⃣  Restaurar pacotes -----------------------------------------
# Copie apenas os arquivos de configuração de pacotes e as.props
COPY src/Directory.Packages.props .
COPY src/Directory.Build.props .

# Copie apenas os csproj para aproveitar o cache
COPY src/Startup/*.csproj  Startup/
COPY src/Persistence/**/*.csproj Persistence/

# Restaurar pacotes
RUN dotnet restore Startup/*.csproj Persistence/**/*.csproj

# --- 2️⃣  Copie o restante do código -----------------------------
COPY src/ .

# --- 3️⃣  Compilar -----------------------------------------------------------
# Ajuste os nomes dos projetos de acordo com sua solução
# aqui assumimos que o projeto que abre o servidor está em
# src/Startup/Server/Server.csproj
RUN dotnet build Startup/Server/Server.csproj \
    -c Release \
    -o /app/build \
    -p:ci=true

# ---- Publish stage (gera o artefacto final) ----------------------------
FROM build AS publish
RUN dotnet publish Startup/Server/Server.csproj \
    -c Release \
    -o /app/publish \
    -p:ci=true

# ---- Final stage (runtime) -----------------------------------------------
FROM mcr.microsoft.com/dotnet/runtime:8.0 AS final
WORKDIR /app

# Copie apenas os artefatos produzidos, incluindo as DLLs de plugins
COPY --from=publish /app/publish .

# Permissões para logs
RUN mkdir -p /app/logs && chmod 777 /app/logs

# Usuário (opcional) – só necessário se você quiser separar UID/GID
ARG APP_UID=1000
USER ${APP_UID}

# Expose as portas usadas pelo OpenMU
EXPOSE 8080 55901 55902 55903 55904 55905 55906 44405 55980

# Starto o servidor
ENTRYPOINT ["dotnet", "Server.dll", "-autostart"]
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .

# Install Node.js for npx (required by Network.Packets project)
RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm && rm -rf /var/lib/apt/lists/*

# Build SourceGenerator first (required by Persistence and EntityFramework projects)
RUN dotnet build /src/src/Persistence/SourceGenerator/MUnique.OpenMU.Persistence.SourceGenerator.csproj -c Release

# Build and publish the main project (ci=true skips Sass compilation target)
RUN dotnet publish /src/src/Startup/MUnique.OpenMU.Startup.csproj -c Release -o /out -p:ci=true

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine
WORKDIR /app
COPY --from=build /out ./
RUN apk add --no-cache krb5-libs
ENTRYPOINT ["dotnet", "MUnique.OpenMU.Startup.dll"]
@using MUnique.OpenMU.DataModel.Configuration
@using MUnique.OpenMU.DataModel.Entities
@using MUnique.OpenMU.GameLogic
@using MUnique.OpenMU.GameLogic.PlugIns.ChatCommands
@using MUnique.OpenMU.Persistence
@using MUnique.OpenMU.Web.Shared.Services

@inject ILookupController LookupController

<div class="custom-move-editor">
    @if (this.PluginActive == false)
    {
        <div class="alert alert-warning py-2" role="alert">
            <strong>The custom move plugin is deactivated.</strong> The moves below have no effect until the plugin is activated again on the plugins page of the admin panel. This activation state is independent of the <code>Enabled</code> flag of this configuration.
        </div>
    }
    <div class="form-group form-check mb-3">
        <InputCheckbox id="customMoveEnabled" @bind-Value="this.Configuration.Enabled" class="form-check-input" />
        <label for="customMoveEnabled" class="form-check-label">Enabled</label>
        <small class="form-text text-muted d-block">Enables or disables the custom move system.</small>
    </div>

    <h5>Moves</h5>
    <small class="form-text text-muted d-block mb-2">List of registered custom moves. Each move can be triggered in the chat with its command, e.g. <code>/bar</code>.</small>

    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Command</th>
                <th>Map</th>
                <th style="width: 70px;">X</th>
                <th style="width: 70px;">Y</th>
                <th style="width: 100px;">Cost</th>
                <th style="width: 90px;">Min Level</th>
                <th style="width: 60px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var move in this.Configuration.Moves)
            {
                <tr>
                    <td>
                        <input type="text" class="form-control form-control-sm" @bind="move.Name" placeholder="bar" title="Name shown in the success message" />
                    </td>
                    <td>
                        <input type="text" class="form-control form-control-sm" @bind="move.Command" placeholder="bar" title="Chat command, with or without slash (e.g. bar or /bar). /bar triggers this move." />
                    </td>
                    <td>
                        <BlazoredTypeahead TItem="GameMapDefinition" TValue="GameMapDefinition"
                                           Value="move.Map"
                                           ValueChanged="@(map => this.OnMapChanged(move, map))"
                                           ValueExpression="@(() => move.Map)"
                                           SearchMethod="@(text => this.LookupController.GetSuggestionsAsync<GameMapDefinition>(text, this.PersistenceContext))"
                                           EnableDropDown="true"
                                           MaximumSuggestions="20"
                                           placeholder="Search map ..."
                                           class="form-control-sm">
                            <SelectedTemplate Context="map">
                                @(map?.Name ?? string.Empty)
                            </SelectedTemplate>
                            <ResultTemplate Context="map">
                                @map.Name
                            </ResultTemplate>
                        </BlazoredTypeahead>
                    </td>
                    <td>
                        <InputByte class="form-control form-control-sm" @bind-Value="move.X" />
                    </td>
                    <td>
                        <InputByte class="form-control form-control-sm" @bind-Value="move.Y" />
                    </td>
                    <td>
                        <InputNumber class="form-control form-control-sm" @bind-Value="move.Cost" title="Zen cost. 0 = free" />
                    </td>
                    <td>
                        <InputNumber class="form-control form-control-sm" @bind-Value="move.MinLevel" />
                    </td>
                    <td>
                        <button type="button" class="btn btn-danger btn-sm" title="Remove this move" @onclick="() => this.OnRemoveMove(move)">
                            <span class="oi oi-trash" aria-hidden="true"></span>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="8">
                    <button type="button" class="btn btn-primary btn-sm" @onclick="this.OnAddMove">
                        <span class="oi oi-plus" aria-hidden="true"></span> Add Move
                    </button>
                </td>
            </tr>
        </tfoot>
    </table>

    @if (this.GetDuplicateMoveWarnings() is { Count: > 0 } duplicateWarnings)
    {
        <div class="alert alert-warning py-2" role="alert">
            <strong>Duplicate commands detected:</strong>
            <ul class="mb-0">
                @foreach (var warning in duplicateWarnings)
                {
                    <li>@warning</li>
                }
            </ul>
        </div>
    }
</div>

@code {
    /// <summary>
    /// Gets or sets the configuration which is being edited.
    /// </summary>
    [Parameter]
    public CustomMoveConfiguration Configuration { get; set; } = null!;

    /// <summary>
    /// Gets or sets a value indicating whether the plugin itself is activated
    /// (<c>PlugInConfiguration.IsActive</c>, managed on the plugins page of the admin panel).
    /// The moves only have an effect while the plugin is activated; this state is
    /// independent of the <c>Enabled</c> flag of the <see cref="Configuration"/>.
    /// When it is <c>null</c> (unknown), no activation warning is shown.
    /// </summary>
    [Parameter]
    public bool? PluginActive { get; set; }

    /// <summary>
    /// Gets or sets the persistence context which is required for the map lookup.
    /// </summary>
    [CascadingParameter]
    public IContext PersistenceContext { get; set; } = null!;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        this.Configuration.Moves ??= new List<CustomMoveEntry>();
    }

    private void OnAddMove()
    {
        this.Configuration.Moves.Add(new CustomMoveEntry(Guid.NewGuid()));
    }

    private void OnRemoveMove(CustomMoveEntry move)
    {
        this.Configuration.Moves.Remove(move);
    }

    private void OnMapChanged(CustomMoveEntry move, GameMapDefinition? map)
    {
        move.Map = map;
    }

    /// <summary>
    /// Gets warnings for duplicated move names or commands (delegates to
    /// <see cref="CustomMoveService.GetDuplicateCommandWarnings" />).
    /// </summary>
    /// <returns>The list of warning messages; empty if there are no duplicates.</returns>
    private List<string> GetDuplicateMoveWarnings() => CustomMoveService.GetDuplicateCommandWarnings(this.Configuration);
}
